{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "豆类结构食品试验库领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "FORMULA_FROZEN",
        "RUN_STARTED",
        "MEASUREMENT_INGESTED",
        "PANEL_COMPLETED",
        "SCALEUP_REVIEWED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "ingredient_lot",
        "experiment_run",
        "measurement_series",
        "scaleup_trial"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
