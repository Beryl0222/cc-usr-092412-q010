{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "豆类结构食品试验库领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "FORMULA_FROZEN",
        "PANEL_COMPLETED",
        "SCALEUP_REVIEWED",
        "LOT_REGISTERED",
        "PRETREATMENT_APPLIED",
        "SAMPLE_SPLIT",
        "SAMPLE_MERGED",
        "BLIND_CODE_ISSUED",
        "STUDY_UNBLINDED",
        "CALIBRATION_RECORDED",
        "CALIBRATION_INVALIDATED",
        "RUN_STARTED",
        "RUN_COMPLETED",
        "RUN_FAILED",
        "MEASUREMENT_INGESTED",
        "EXCLUSION_REQUESTED",
        "EXCLUSION_CONFIRMED",
        "EXCLUSION_REJECTED",
        "BATCH_OPENED",
        "BATCH_CHECKPOINT",
        "BATCH_RESUMED",
        "INVESTIGATION_OPENED",
        "INVESTIGATION_RESOLVED",
        "REPORT_CREATED",
        "REPORT_SIGNED",
        "REPORT_ADDENDUM"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "ingredient_lot",
        "sample",
        "study",
        "instrument",
        "experiment_run",
        "measurement_series",
        "batch_session",
        "investigation",
        "report",
        "scaleup_trial"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "payload": {
      "type": "object"
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
